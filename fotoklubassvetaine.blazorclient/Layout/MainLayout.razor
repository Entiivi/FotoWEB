@inherits LayoutComponentBase
@inject NavigationManager Navigation
@using Microsoft.Fast.Components.FluentUI

<FluentDesignSystemProvider>
    @if (!Navigation.Uri.Contains("/login"))
    {
        <div class="mainnav">
                <FluentButton Appearance="Appearance.Accent" @onclick="NavigateTomain">Main</FluentButton>
                <FluentButton Appearance="Appearance.Accent" @onclick="NavigateToPhotos">Photos</FluentButton>
                <FluentButton Appearance="Appearance.Accent" @onclick="NavigateToEdit">Edit</FluentButton>
                <FluentButton Appearance="Appearance.Accent" @onclick="NavigateToUploadPhoto">Upload Photo</FluentButton>
                <FluentButton Appearance="Appearance.Accent" @onclick="NavigateToLoginAccount">Account</FluentButton>
               
        </div>
    }

    <div Class="maincontainercontent">
            @Body
        <div class="footer">
            <!-- About Section -->
            <section class="about-section">
                <h2>About FotoKlubas</h2>
                <p>FotoKlubas is a vibrant community of photography enthusiasts. Whether you're a beginner or a pro, share your shots, explore stunning images, and connect with fellow photographers.</p>
            </section>

            <!-- Contact Section -->
            <section class="contact-section">
                <h2>Contact Us</h2>
                <p>Email: support@fotoklubas.com | Phone: +370 123 4567</p>
                <FluentButton Appearance="Appearance.Accent" @onclick="NavigateToContact">Get in Touch</FluentButton>
            </section>

       
            <footer class="footer">
                &copy; @DateTime.Now.Year FotoKlubas. All Rights Reserved.
            </footer>
        </div>
    </div>
</FluentDesignSystemProvider>

<!-- Fluent UI Providers -->
<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />
<FluentMenuProvider />

@code {
    private void NavigateToUploadPhoto() => Navigation.NavigateTo("/upload");
    private void NavigateToLoginAccount() => Navigation.NavigateTo("/account-info");
    private void NavigateToEdit() => Navigation.NavigateTo("/editor");
    private void NavigateToPhotos() => Navigation.NavigateTo("/photos");
    private void NavigateTomain() => Navigation.NavigateTo("/main");
    private void NavigateToContact() => Navigation.NavigateTo("/contact");
}
