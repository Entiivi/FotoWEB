@page "/chatbot"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<link href="css/ChatBot.css" rel="stylesheet" />

<h3>Fotoklubo Pagalbininkas</h3>

<div style="max-width: 600px; margin: auto;">
    <div class="chat-box" id="chatBox" style="border: 1px solid #ccc; padding: 10px; max-height: 500px; overflow-y: auto;">
        @foreach (var message in messages)
        {
            <div class="chat-message @(message.IsUser ? "user-message" : "bot-message")" style="margin-bottom: 10px;">
                <span class="timestamp">@message.Timestamp.ToShortTimeString()</span>
                <strong>@(message.IsUser ? "Tu:" : "Botas:")</strong> @message.Text
                @if (message.ActionButton != null)
                {
                    <div>
                        <button @onclick="() => Navigation.NavigateTo(message.ActionButton.TargetUrl)" class="btn btn-sm btn-primary mt-1">
                            @message.ActionButton.Label
                        </button>
                    </div>
                }
            </div>
        }
    </div>

    <div class="input-section mt-3">
        <input @bind="userInput" @bind:event="oninput" @onkeydown="HandleKeyPress" class="form-control" placeholder="Klausk apie nuotraukas arba redagavimą..." />
        <button @onclick="SendMessage" class="btn btn-success mt-2">Siųsti</button>
    </div>
</div>

@code {
    private string userInput = "";
    private List<ChatMessage> messages = new();
    private List<FotografijaInfo> fotoInfoList = new();
    // Laikome paskutinę temą (pvz., "seniausia nuotrauka", "redagavimas" ir pan.), kad galėtume interpretuoti kontekstinius užklausimus.
    private string lastTopic = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<List<FotografijaInfo>>("fotografija/info");
            if (result != null)
            {
                fotoInfoList = result;
            }
            else
            {
                messages.Add(new ChatMessage
                    {
                        Text = "Nepavyko gauti nuotraukų informacijos.",
                        IsUser = false,
                        Timestamp = DateTime.Now
                    });
            }
        }
        catch (Exception ex)
        {
            messages.Add(new ChatMessage
                {
                    Text = $"Įvyko klaida: {ex.Message}",
                    IsUser = false,
                    Timestamp = DateTime.Now
                });
        }

        // Personalizuotas sveikinimas pagal dabartinį dienos laiką:
        var hour = DateTime.Now.Hour;
        string greeting = hour < 12 ? "Labiaurės" : hour < 18 ? "Laba diena" : "Labvakar";
        messages.Add(new ChatMessage
            {
                Text = $"{greeting}! Užduokite klausimą apie nuotraukas, pvz., “Kokia nuotrauka seniausia?”, “Kiek nuotraukų turime?” ar “Kaip redaguoti nuotrauką?”",
                IsUser = false,
                Timestamp = DateTime.Now
            });
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput))
            return;

        // Pridedame vartotojo žinutę
        var trimmedInput = userInput.Trim();
        messages.Add(new ChatMessage { Text = trimmedInput, IsUser = true, Timestamp = DateTime.Now });
        await ScrollToBottom();

        // Rodyk "rašoma..." indikatorių
        var typingMessage = new ChatMessage { Text = "Botas rašo...", IsUser = false, Timestamp = DateTime.Now };
        messages.Add(typingMessage);
        await ScrollToBottom();

        // Simuliuojame trumpą laukimo laiką prieš generuojant galutinį atsakymą
        await Task.Delay(1000);

        // Pašaliname "rašoma..." žinutę
        messages.Remove(typingMessage);

        // Generuojame atsakymą, atsižvelgdami į kontekstą ir užklausą
        var botResponse = GenerateBotResponse(trimmedInput);
        messages.Add(botResponse);
        await ScrollToBottom();

        userInput = "";
    }

    private async Task ScrollToBottom()
    {
        // JS funkcija turėtų būti aprašyta index.html arba atskirame JS faile, kaip nurodyta dokumentacijoje
        await JS.InvokeVoidAsync("scrollToBottom", "chatBox");
    }

    private ChatMessage GenerateBotResponse(string input)
    {
        // Naudojame input formos mažųjų raidžių versiją, bet toliau atliekame case-insensitive palyginimus
        string lowerInput = input.ToLower();
        DateTime currentTimestamp = DateTime.Now;

        // Sveikinimai (pvz., "labas", "sveiki")
        if (lowerInput.Contains("labas") || lowerInput.Contains("sveiki"))
        {
            lastTopic = "sveikinimas";
            return new ChatMessage
                {
                    Text = "Sveiki, kaip galiu padėti? Galite klausti apie seniausias/naujausias nuotraukas, redagavimą arba filtrus.",
                    IsUser = false,
                    Timestamp = currentTimestamp
                };
        }

        // Klausimas apie seniausią nuotrauką
        if (lowerInput.Contains("seniaus") || lowerInput.Contains("pirm"))
        {
            var oldest = fotoInfoList.OrderBy(f => f.Data).FirstOrDefault();
            if (oldest != null)
            {
                lastTopic = "seniausia nuotrauka";
                return new ChatMessage
                    {
                        Text = $"Seniausia nuotrauka yra „{oldest.Pavadinimas}“, įkelta {oldest.Data}.",
                        IsUser = false,
                        Timestamp = currentTimestamp,
                        ActionButton = new ChatActionButton
                        {
                            Label = "Peržiūrėti",
                            TargetUrl = $"/photo-editor/{Uri.EscapeDataString(oldest.Pavadinimas)}"
                        }
                    };
            }
        }

        // Klausimas apie naujausią nuotrauką
        if (lowerInput.Contains("naujaus") || lowerInput.Contains("paskutin"))
        {
            var newest = fotoInfoList.OrderByDescending(f => f.Data).FirstOrDefault();
            if (newest != null)
            {
                lastTopic = "naujausia nuotrauka";
                return new ChatMessage
                    {
                        Text = $"Naujausia nuotrauka yra „{newest.Pavadinimas}“, įkelta {newest.Data}.",
                        IsUser = false,
                        Timestamp = currentTimestamp,
                        ActionButton = new ChatActionButton
                        {
                            Label = "Peržiūrėti",
                            TargetUrl = $"/photo-editor/{Uri.EscapeDataString(newest.Pavadinimas)}"
                        }
                    };
            }
        }

        // Klausimas apie redagavimą
        if (lowerInput.Contains("redaguoti") || lowerInput.Contains("redagavimas"))
        {
            lastTopic = "redagavimas";
            return new ChatMessage
                {
                    Text = "Norėdami redaguoti nuotrauką, eikite į skyrių „Mano nuotraukos“ ir pasirinkite norimą. Taip pat galite naudoti kitus redagavimo įrankius, kuriuos rasite meniu.",
                    IsUser = false,
                    Timestamp = currentTimestamp
                };
        }

        // Klausimas apie filtrus arba efektus
        if (lowerInput.Contains("filtr") || lowerInput.Contains("efekt"))
        {
            lastTopic = "efektai";
            return new ChatMessage
                {
                    Text = "Redagavimo lange galite naudoti įvairius filtrus, keisti ryškumą, pasukti ar apkarpyti nuotrauką. Išbandykite skirtingus efektus!",
                    IsUser = false,
                    Timestamp = currentTimestamp
                };
        }

        // Klausimas apie bendrą nuotraukų skaičių
        if ((lowerInput.Contains("kiek") && lowerInput.Contains("nuotrauk")) || lowerInput.Contains("skaičius"))
        {
            lastTopic = "nuotraukų skaičius";
            return new ChatMessage
                {
                    Text = $"Šiuo metu turime {fotoInfoList.Count} nuotraukų.",
                    IsUser = false,
                    Timestamp = currentTimestamp
                };
        }

        // Klausimai apie nuotraukų kategorijas (pvz., "landšaft", "portret")
        if (lowerInput.Contains("landšaft") || lowerInput.Contains("gamta"))
        {
            lastTopic = "landšaftai";
            var categoryPhotos = fotoInfoList.Where(f => f.Kategorija.ToLower().Contains("landšaft")).ToList();
            if (categoryPhotos.Any())
            {
                return new ChatMessage
                    {
                        Text = $"Turime {categoryPhotos.Count} landšaftų nuotraukų. Pavyzdžiui, „{categoryPhotos.First().Pavadinimas}“.",
                        IsUser = false,
                        Timestamp = currentTimestamp
                    };
            }
            else
            {
                return new ChatMessage
                    {
                        Text = "Šiuo metu neturime landšaftų nuotraukų.",
                        IsUser = false,
                        Timestamp = currentTimestamp
                    };
            }
        }

        if (lowerInput.Contains("portret"))
        {
            lastTopic = "portretai";
            var categoryPhotos = fotoInfoList.Where(f => f.Kategorija.ToLower().Contains("portret")).ToList();
            if (categoryPhotos.Any())
            {
                return new ChatMessage
                    {
                        Text = $"Yra {categoryPhotos.Count} portretų nuotraukų. Pavyzdžiui, „{categoryPhotos.First().Pavadinimas}“.",
                        IsUser = false,
                        Timestamp = currentTimestamp
                    };
            }
            else
            {
                return new ChatMessage
                    {
                        Text = "Šiuo metu neturime portretų nuotraukų.",
                        IsUser = false,
                        Timestamp = currentTimestamp
                    };
            }
        }

        // Kontekstiniai klausimai, pvz., "dar" arba "toliau", remiantis ankstesne tema
        if ((lowerInput.Contains("dar") || lowerInput.Contains("toliau")) && !string.IsNullOrEmpty(lastTopic))
        {
            return new ChatMessage
                {
                    Text = lastTopic switch
                    {
                        "redagavimas" => "Papildomai galite patikrinti redagavimo meniu, kuriame rasite įvairių efektų ir įrankių, kaip pakeisti nuotraukos parametrus.",
                        "seniausia nuotrauka" => "Jeigu norite daugiau informacijos apie seniausias nuotraukas, galite paspausti mygtuką, kuris nukreips jus į redagavimo puslapį.",
                        _ => "Ar galėčiau padėti išsamiau apie temą: " + lastTopic + "?"
                    },
                    IsUser = false,
                    Timestamp = currentTimestamp
                };
        }

        // Jei vartotojas įveda žinutę, susijusią su konkretaus pavadinimo paieška.
        // Jei pradžioje yra žodis "nuotrauka", jį pašaliname, o likusią dalį naudojame kaip kandidato raktą.
        string candidate = input.Trim();
        if (candidate.StartsWith("nuotrauka", StringComparison.OrdinalIgnoreCase))
        {
            candidate = candidate.Substring("nuotrauka".Length).Trim();
        }
        // Bandome rasti nuotrauką, kurios pavadinimas lygus arba bent iš dalies sutampa (case-insensitive).
        var match = fotoInfoList.FirstOrDefault(f =>
            f.Pavadinimas.Equals(candidate, StringComparison.OrdinalIgnoreCase)
            || f.Pavadinimas.IndexOf(candidate, StringComparison.OrdinalIgnoreCase) >= 0);

        if (match != null)
        {
            return new ChatMessage
                {
                    Text = $"Apie „{match.Pavadinimas}“: {match.Aprasymas}. Įkelta {match.Data}.",
                    IsUser = false,
                    Timestamp = currentTimestamp,
                    ActionButton = new ChatActionButton
                    {
                        Label = "Redaguoti šią nuotrauką",
                        TargetUrl = $"/photo-editor/{Uri.EscapeDataString(match.Pavadinimas)}"
                    }
                };
        }

        // Pagalbos klausimai arba natūralios kalbos patarimai
        if (lowerInput.Contains("pagalba") || lowerInput.Contains("kaip"))
        {
            return new ChatMessage
                {
                    Text = "Pabandykite užduoti klausimą taip: “Kokia nuotrauka seniausia?”, “Kiek nuotraukų turime?” arba “Kaip redaguoti nuotrauką?”. Taip pat galite įvesti nuotraukos pavadinimą, pvz., “nuotrauka Puodelis” arba tiesiog “Puodelis”.",
                    IsUser = false,
                    Timestamp = currentTimestamp,
                    ActionButton = new ChatActionButton
                    {
                        Label = "Dažnai užduodami klausimai (FAQ)",
                        TargetUrl = "/faq"
                    }
                };
        }

        // Jei nė viena sąlyga neatitiko – grąžiname standartinį atsakymą.
        return new ChatMessage
            {
                Text = "Atsiprašau, nesupratau klausimo. Gal galite paklausti kitaip? Pvz., “Kokia nuotrauka naujausia?” arba “Kaip redaguoti nuotrauką?”",
                IsUser = false,
                Timestamp = currentTimestamp
            };
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }


    // Modeliai
    public class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsUser { get; set; }
        public DateTime Timestamp { get; set; } = DateTime.Now;
        public ChatActionButton? ActionButton { get; set; }
    }

    public class ChatActionButton
    {
        public string Label { get; set; } = "";
        public string TargetUrl { get; set; } = "";
    }

    public class FotografijaInfo
    {
        public int FotoID { get; set; }
        public string Pavadinimas { get; set; } = "";
        public string Aprasymas { get; set; } = "";
        public string Data { get; set; } = "";
        // Naujas laukas – nuotraukos kategorija (pvz., "landšaft", "portret")
        public string Kategorija { get; set; } = "";
    }
}
