@page "/main"
@inject NavigationManager Navigation
@inject HttpClient Http

<link rel="stylesheet" href="/css/mainblazor.css" />

<div class="homepage-container">

    <!-- Hero Section -->
    <FluentCard class="hero-section">
        <h1>Welcome to FotoKlubas</h1>
        <p>Share, explore, and cherish the best moments captured by our community.</p>
        <FluentButton Appearance="Appearance.Accent" @onclick="NavigateToGallery">Explore Gallery</FluentButton>
    </FluentCard>

    <!-- Recent Uploads Section -->
    <section class="recent-uploads">
        <h2>Recent Uploads</h2>
        @if (loading)
        {
            <FluentProgressRing />
        }
        else if (photos == null || photos.Count == 0)
        {
            <p>No photos available. Be the first to upload!</p>
        }
        else
        {
            <div class="photo-grid">
                @foreach (var photo in photos.Take(5))
                {
                    <FluentCard class="photo-card" @onclick="() => HandlePhotoClick(photo)">
                        <img src="@($"https://localhost:7001/{photo.FotoPath}")" alt="@photo.Pavadinimas">
                        <p class="photo-title">@photo.Pavadinimas</p>
                    </FluentCard>
                }
            </div>
        }
    </section>

    <!-- Photo of the Month Section -->
    <section class="photo-of-month">
        <FluentCard class="photo-month-card">
            <h3>Photo of the Month</h3>
            <img src="https://localhost:7001/Nuotraukos/DSC_1040.JPG" alt="Photo of the Month">
            <p>Captured by: <strong>Ignas Sakalauskas</strong></p>
        </FluentCard>
    </section>
</div>

@code {
    private List<Photo> photos = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPhotosAsync();
    }

    private async Task LoadPhotosAsync()
    {
        try
        {
            var response = await Http.GetAsync("https://localhost:7001/fotografija");
            if (response.IsSuccessStatusCode)
            {
                photos = await response.Content.ReadFromJsonAsync<List<Photo>>() ?? new List<Photo>();
            }
            else
            {
                Console.WriteLine($"Failed to fetch photos. Status code: {response.StatusCode}");
            }
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"HTTP error: {ex.Message}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unexpected error: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void NavigateToGallery() => Navigation.NavigateTo("/photos");
    private void NavigateToContact() => Navigation.NavigateTo("/contact");

    private void HandlePhotoClick(Photo photo)
    {
        Navigation.NavigateTo($"/photo-details/{photo.FotoID}");
    }

    private class Photo
    {
        public int FotoID { get; set; }
        public string? Pavadinimas { get; set; }
        public string? FotoPath { get; set; }
    }
}
