@page "/"
@inject HttpClient Http
@inject NavigationManager Navigation
@using Microsoft.Fast.Components.FluentUI

<link rel="stylesheet" href="css/mainblazor.css" />

<!-- Main Layout -->
<FluentDesignSystemProvider style="width: 100vw; height: 100vh; overflow: auto; background-color: #2C253B; color: white; font-family: 'Arial', sans-serif; padding: 20px;">

    <!-- Hero Section -->
    <FluentCard style="text-align: center; padding: 60px 20px; background: linear-gradient(45deg, #6a5acd, #8a2be2); color: white; border-radius: 16px; margin-bottom: 30px;">
        <h1>Welcome to FotoKlubas 📷</h1>
        <p>Share, explore, and cherish the best moments captured by our community.</p>
        <FluentButton Appearance="Appearance.Accent" @onclick="NavigateToGallery">Explore Gallery</FluentButton>
        <FluentButton Appearance="Appearance.Neutral" @onclick="NavigateToRegister" style="margin-left: 10px;">Join Now</FluentButton>
    </FluentCard>

    <!-- Recent Uploads Section -->
    <section style="margin-bottom: 30px;">
        <h2>📸 Recent Uploads</h2>
        @if (loading)
        {
            <FluentProgressRing />
        }
        else if (photos == null || photos.Count == 0)
        {
            <p>No photos available. Be the first to upload!</p>
        }
        else
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px;">
                @foreach (var photo in photos.Take(6)) // Show 6 recent photos
                {
                    <FluentCard style="overflow: hidden; border-radius: 8px; cursor: pointer;" @onclick="() => HandlePhotoClick(photo)">
                        <img src="@($"https://localhost:5027/Nuotraukos/{photo.FotoPath}")" alt="@photo.Pavadinimas"
                             style="width: 100%; height: 200px; object-fit: cover; transition: transform 0.3s;"
                             onmouseover="this.style.transform='scale(1.05)'"
                             onmouseout="this.style.transform='scale(1)'">
                        <p style="text-align: center; margin: 10px 0;">@photo.Pavadinimas</p>
                    </FluentCard>
                }
            </div>
        }
    </section>

    <!-- Photo of the Month Section -->
    <section style="margin-bottom: 30px;">
        <FluentCard style="padding: 20px; background-color: #3e3e3e; border-radius: 16px;">
            <h3>🌟 Photo of the Month</h3>
            <img src="https://localhost:5027/Nuotraukos/featured.jpg" alt="Photo of the Month"
                 style="width: 100%; border-radius: 8px; margin: 10px 0;">
            <p>Captured by: <strong>John Doe</strong></p>
        </FluentCard>
    </section>

    <!-- About Section -->
    <section style="margin-bottom: 30px; text-align: center;">
        <h2>💡 About FotoKlubas</h2>
        <p>FotoKlubas is a vibrant community of photography enthusiasts. Whether you're a beginner or a pro, share your shots, explore stunning images, and connect with fellow photographers.</p>
    </section>

    <!-- Contact Section -->
    <section style="margin-bottom: 30px; text-align: center;">
        <h2>📞 Contact Us</h2>
        <p>Email: support@fotoklubas.com | Phone: +370 123 4567</p>
        <FluentButton Appearance="Appearance.Accent" @onclick="NavigateToContact">Get in Touch</FluentButton>
    </section>

    <!-- Footer -->
    <footer style="text-align: center; padding: 10px; background-color: #1f1f1f; border-radius: 8px;">
        &copy; @DateTime.Now.Year FotoKlubas. All Rights Reserved.
    </footer>
</FluentDesignSystemProvider>

@code {
    private List<Photo> photos = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPhotosAsync();
    }

    private async Task LoadPhotosAsync()
    {
        try
        {
            var response = await Http.GetAsync("https://localhost:5027/fotografija");
            if (response.IsSuccessStatusCode)
            {
                photos = await response.Content.ReadFromJsonAsync<List<Photo>>() ?? new List<Photo>();
            }
            else
            {
                Console.WriteLine($"Failed to fetch photos. Status code: {response.StatusCode}");
            }
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"HTTP error: {ex.Message}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Unexpected error: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    // Navigation Methods
    private void NavigateToGallery() => Navigation.NavigateTo("/gallery");
    private void NavigateToRegister() => Navigation.NavigateTo("/register");
    private void NavigateToContact() => Navigation.NavigateTo("/contact");

    private void HandlePhotoClick(Photo photo)
    {
        Navigation.NavigateTo($"/photo-details/{photo.FotoID}");
    }

    private class Photo
    {
        public int FotoID { get; set; }
        public string? Pavadinimas { get; set; }
        public string? FotoPath { get; set; }
    }
}
