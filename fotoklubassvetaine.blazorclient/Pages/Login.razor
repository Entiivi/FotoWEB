@page "/login"
@inject HttpClient Http
@inject NavigationManager Navigation
@using Microsoft.Fast.Components.FluentUI


<link rel="stylesheet" href="/css/loginblazor.css" />
<div class="login-container1">

    <!-- Quote Section -->
    <div class="mainimage">
        <div class="image-wrapper">
            <img src="/images/mainimage1.jpg" alt="Inspirational Image" class="quote-image" />
            <div class="quote-overlay">
                <FluentTypography Variant="Title" class="quote-text">
                    "Photography is the story I fail to put into words." – Destin Sparks
                </FluentTypography>
            </div>
        </div>
    </div>

    <div class="login-content">
        <!-- Login Form -->
        <div class="login-form">
            <pirmas Style="font-size: 4rem;">Login</pirmas>

            <FluentTextField @bind-value="username" Placeholder="Enter Username" Style="width: 100%; margin-top: 8vh" />
            <FluentTextField @bind-value="password" Placeholder="Enter Password" Type="password" Style="width: 100%; margin-top: 4vh" />

            <FluentButton Appearance="Appearance.Accent" OnClick="LoginUser" Style="width: 100%; margin-top: 15px;">Login</FluentButton>
            <FluentButton Appearance="Appearance.Accent" OnClick="Createanaccount" Style="width: 100%; margin-top: 5px;">Create an account</FluentButton>



            <antras Style="margin-top: 5px;">Or login with</antras>

            <div class="social-buttons" Style="margin-top: 5px;">
                <FluentButton Appearance="Appearance.Accent" OnClick="LoginWithGoogle" class="google-login">
                    <img src="/images/google.svg" alt="Google Icon" style="width: 24px; height: 24px; margin-right: 5px;" />
                    Google
                </FluentButton>

                <FluentButton Appearance="Appearance.Accent" OnClick="LoginWithGitHub" class="github-login">
                    <img src="/images/github.svg" alt="GitHub Icon" style="width: 24px; height: 24px; margin-right: 5px;" />
                    GitHub
                </FluentButton>
            </div>
        </div>
    </div>
</div>


@code {
    @code {
        private string username = "";
        private string password = "";

        private async Task LoginUser()
        {
            if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
            {
                Console.WriteLine("Username and password are required.");
                return;
            }

            var credentials = new
            {
                Username = username,
                Password = password
            };

            try
            {
                var response = await Http.PostAsJsonAsync("https://localhost:7001/login", credentials);

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadAsStringAsync();
                    Console.WriteLine($"Login successful: {result}");
                    Navigation.NavigateTo("/main");
                }
                else
                {
                    Console.WriteLine("Invalid username or password.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error during login: {ex.Message}");
            }
        }
    }

    private void Createanaccount() => Navigation.NavigateTo("https://localhost:7/create-account", forceLoad: true);
    private void LoginWithGoogle() => Navigation.NavigateTo("https://localhost:7001/login/google", forceLoad: true);
    private void LoginWithGitHub() => Navigation.NavigateTo("https://localhost:7001/login/github", forceLoad: true);
}
    

