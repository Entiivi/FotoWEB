@page "/photos"
@inject HttpClient Http
@inject NavigationManager Navigation

<link rel="stylesheet" href="css/photos.css" />

<FluentCard style="display: flex; min-height: 100vh; background-color: #f5f5f5; padding: 16px; gap: 16px;">

    <!-- Photo Gallery -->
    <FluentCard style="flex-grow: 1; padding: 24px;">
        @if (loading)
        {
            <FluentProgressRing />
        }
        else if (photos == null || photos.Count == 0)
        {
            <FluentTypography Variant="Body1" style="text-align: center; color: #757575;">
                No photos available.
            </FluentTypography>
        }
        else
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px;">
                @foreach (var photo in photos)
                {
                    <FluentCard style="overflow: hidden; border-radius: 8px; cursor: pointer;" @onclick="() => HandlePhotoClick(photo)">
                        <img src="@($"https://localhost:7001/{photo.FotoPath}")" alt="@photo.Pavadinimas"
                             style="width: 100%; height: 200px; object-fit: cover; transition: transform 0.3s;"
                             onmouseover="this.style.transform='scale(1.05)'"
                             onmouseout="this.style.transform='scale(1)'">
                    </FluentCard>
                }
            </div>
        }
    </FluentCard>
</FluentCard>

@code {
    private List<Photo> photos = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPhotosAsync();
    }

    private async Task LoadPhotosAsync()
    {
        try
        {
            var response = await Http.GetAsync("fotografija");  // Ensure BaseAddress works
            if (response.IsSuccessStatusCode)
            {
                photos = await response.Content.ReadFromJsonAsync<List<Photo>>() ?? new List<Photo>();
            }
            else
            {
                Console.WriteLine($"Failed to fetch photos. Status code: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching photos: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void HandlePhotoClick(Photo photo)
    {
        Navigation.NavigateTo($"/photo/{photo.Pavadinimas}");
    }

    private class Photo
    {
        public int FotoID { get; set; }
        public string? Pavadinimas { get; set; }
        public string? Aprasymas { get; set; }
        public string? FotoPath { get; set; }
    }
}